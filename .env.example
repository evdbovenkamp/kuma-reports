# --- Uptime Kuma database -------------------------------------------------------
# Default (auto): reads /kuma/db-config.json from Kuma's data directory and picks
#   SQLite        -> /kuma/kuma.db (opened read-only)
#   embedded MariaDB (Kuma 2.x) -> socket /kuma/run/mariadb.sock
#   external MariaDB            -> host/port/database from db-config.json
KUMA_DB_TYPE=auto
# Read-only database user for MariaDB/MySQL (see README for the GRANT statement).
KUMA_DB_USER=reporter
KUMA_DB_PASSWORD=
# KUMA_DB_HOST=mariadb
# KUMA_DB_PORT=3306
# KUMA_DB_NAME=kuma
# Or a full SQLAlchemy URL instead of all of the above:
# KUMA_DB_URL=mysql+pymysql://reporter:secret@mariadb:3306/kuma

# Public URL of Uptime Kuma, for "view in Kuma" links in reports (optional).
KUMA_BASE_URL=https://status.example.com

# --- Application ----------------------------------------------------------------
TZ=Europe/Amsterdam
# Login: "form" (built-in) or "none" (only behind an authenticating reverse proxy!)
AUTH_MODE=form
ADMIN_USERNAME=admin
# Leave empty to choose a password in the browser on first start.
ADMIN_PASSWORD=
# Public URL of Kuma Reports itself; https:// enables secure cookies.
BASE_URL=
# Serve the GUI under a sub-path, e.g. /reports behind https://kuma.example.com/reports (see README).
BASE_PATH=
# How often new state changes are imported from Kuma (seconds).
IMPORT_INTERVAL=300
# How long archived report HTML is kept (days).
HISTORY_KEEP_DAYS=400
# SECRET_KEY=   # generated and stored in /data when empty
